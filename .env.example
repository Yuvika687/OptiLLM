# OpenAI (required)
OPENAI_API_KEY=sk-your-key-here

# Optional second provider for fallback
ANTHROPIC_API_KEY=

# Database
DATABASE_URL=postgresql://optillm:optillm_dev@localhost:5432/optillm

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS — comma-separated origins. Use * for local demo.
CORS_ORIGINS=http://localhost:3000

# Model Router
DEFAULT_SIMPLE_MODEL=gpt-4o-mini
DEFAULT_COMPLEX_MODEL=gpt-4o
COMPLEXITY_THRESHOLD=0.55

# Semantic Cache
CACHE_SIMILARITY_THRESHOLD=0.92
EMBEDDING_MODEL=text-embedding-3-small
# local (default, no extra API cost) or openai
EMBEDDING_PROVIDER=local

# Frontend (app/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
